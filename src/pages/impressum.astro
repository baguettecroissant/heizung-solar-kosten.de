---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../../site.config';
---

<BaseLayout title={`Impressum | ${siteConfig.name}`} canonical="/impressum">
  <div style="background: var(--primary); color: white; padding: 4rem 0 2rem 0; text-align: center; margin-bottom: 3rem;">
    <div class="container">
      <h1 style="color: white; font-size: 2.25rem;">Impressum</h1>
      <p style="color: rgba(255,255,255,0.8); margin-top: 0.5rem;">Gesetzliche Anbieterkennzeichnung</p>
    </div>
  </div>

  <div class="container" style="max-width: 800px; margin-bottom: 5rem;">
    <div class="card" style="padding: 2.5rem; line-height: 1.8;">
      <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem;">Anbieterangaben</h2>

      <p style="margin-bottom: 1.5rem;">
        <strong>Wade Studio Ltd.</strong><br />
        432 Ave Bounty<br />
        Balaclava 20104<br />
        Mauritius
      </p>

      <h3 style="font-size: 1.15rem; margin-top: 2rem; margin-bottom: 0.5rem;">Vertreten durch</h3>
      <p style="margin-bottom: 1.5rem;">Timothy Wade</p>

      <h3 style="font-size: 1.15rem; margin-top: 2rem; margin-bottom: 0.5rem;">Kontakt</h3>
      <p style="margin-bottom: 1.5rem;">
        E-Mail: <a href="mailto:wadestudioltd@gmail.com" style="text-decoration: underline; color: var(--primary);">wadestudioltd@gmail.com</a>
      </p>

      <h3 style="font-size: 1.15rem; margin-top: 2rem; margin-bottom: 0.5rem;">Haftung für Inhalte und Links</h3>
      <p style="margin-bottom: 1rem;">
        Die Inhalte dieser Website werden mit Sorgfalt erstellt. Eine Gewähr für ihre Richtigkeit, Vollständigkeit und Aktualität wird nur im gesetzlich vorgesehenen Umfang übernommen.
      </p>
      <p style="margin-bottom: 1rem;">
        Diese Website kann Links zu externen Websites enthalten, auf deren Inhalte wir keinen Einfluss haben. Für die Inhalte verlinkter Seiten ist der jeweilige Anbieter oder Betreiber verantwortlich.
      </p>
    </div>
  </div>
</BaseLayout>
