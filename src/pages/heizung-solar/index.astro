---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllStates, getCitiesByState } from '../../lib/cities';
import { siteConfig } from '../../../site.config';

const states = getAllStates();
---

<BaseLayout title={`Städteverzeichnis — Photovoltaik & Wärmepumpe | ${siteConfig.name}`} canonical="/heizung-solar">
  <div style="background: var(--primary); color: white; padding: 4rem 0 2rem 0; text-align: center; margin-bottom: 3rem;">
    <div class="container">
      <span class="hero-badge">📍 Regionale Fachbetriebe</span>
      <h1 style="color: white; font-size: 2.25rem; margin-top: 0.5rem;">Städte- und Regionsverzeichnis</h1>
      <p style="color: rgba(255,255,255,0.8); max-width: 600px; margin: 0.5rem auto 0 auto; font-size: 1rem;">
        Finden Sie Angebote für Solaranlagen und Wärmepumpen in Ihrer Stadt. Wählen Sie Ihr Bundesland aus, um Fachbetriebe vor Ort zu vergleichen.
      </p>
    </div>
  </div>

  <div class="container" style="margin-bottom: 5rem;">
    <div class="grid grid-cols-2" style="gap: 2.5rem; align-items: start;">
      {states.map((state) => {
        const citiesInState = getCitiesByState(state.name);
        return (
          <div class="card" style="padding: 2rem;">
            <h2 style="font-size: 1.35rem; color: var(--primary); font-weight: 800; border-bottom: 2px solid var(--primary-light); padding-bottom: 0.5rem; margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center;">
              <span>🇩🇪 {state.name}</span>
              <span style="font-size: 0.8rem; background-color: var(--primary-light); color: var(--primary); padding: 0.2rem 0.5rem; border-radius: 0.25rem;">
                {state.count} Städte
              </span>
            </h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.5rem;">
              {citiesInState.map((city) => (
                <a href={`/heizung-solar/${city.slug}/`} style="font-size: 0.85rem; color: var(--text); padding: 0.35rem 0.5rem; border-radius: 0.375rem; background-color: #F8FAFC; border: 1px solid #E2E8F0; text-align: center; font-weight: 600;" class="city-link">
                  {city.name}
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <style>
    .city-link:hover {
      border-color: var(--solar-color) !important;
      color: var(--solar-color) !important;
      background-color: #FFF8F1 !important;
      transform: translateY(-1px);
    }
  </style>
</BaseLayout>
