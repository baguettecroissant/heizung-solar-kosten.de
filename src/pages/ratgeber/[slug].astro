---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { getArticleBySlug, getAllArticles } from '../../data/blog-articles';
import { siteConfig } from '../../../site.config';

export function getStaticPaths() {
  const articles = getAllArticles();
  return articles.map((a) => ({
    params: { slug: a.slug },
    props: { article: a },
  }));
}

const { article } = Astro.props;
if (!article) {
  return Astro.redirect('/404');
}

// Get recent articles for the sidebar, excluding the current one
const recentArticles = getAllArticles()
  .filter((a) => a.slug !== article.slug)
  .slice(0, 3);
---

<BaseLayout
  title={`${article.title} | ${siteConfig.name}`}
  description={article.summary}
  canonical={`/ratgeber/${article.slug}`}
>
  <div style="background: var(--primary); color: white; padding: 4rem 0 2.5rem 0; margin-bottom: 3rem;">
    <div class="container" style="max-width: 960px;">
      <span class="font-data" style="font-size: 0.75rem; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em;">
        📚 Ratgeber &gt; {article.category}
      </span>
      <h1 style="color: white; font-size: 2.25rem; margin-top: 0.5rem; line-height: 1.25;">
        {article.title}
      </h1>
      <p style="color: rgba(255,255,255,0.85); font-size: 1.05rem; margin-top: 0.75rem; max-width: 800px; line-height: 1.5;">
        {article.summary}
      </p>
    </div>
  </div>

  <div class="container" style="max-width: 1100px; margin-bottom: 5rem;">
    <div class="article-sidebar-grid">
      <!-- Main Content Column -->
      <article class="card" style="padding: 2.5rem; line-height: 1.8; color: #334155;">
        <img src={article.image} alt={article.title} style="width: 100%; height: auto; border-radius: 0.75rem; margin-bottom: 2rem; box-shadow: var(--shadow-sm);" />
        
        <div class="article-body-content" set:html={article.content} />
        
        <style is:global>
          .article-body-content p {
            margin-bottom: 1.5rem;
            font-size: 1rem;
          }
          .article-body-content h3 {
            font-size: 1.35rem;
            color: var(--primary);
            margin-top: 2rem;
            margin-bottom: 1rem;
            font-weight: 700;
          }
          .article-body-content ul, .article-body-content ol {
            margin-bottom: 1.5rem;
            padding-left: 1.5rem;
          }
          .article-body-content li {
            margin-bottom: 0.5rem;
          }
          .article-body-content strong {
            color: var(--primary);
          }
        </style>
      </article>

      <!-- Sidebar Column -->
      <aside style="display: flex; flex-direction: column; gap: 2rem;">
        <LeadForm />
        
        <!-- Recent Articles -->
        <div class="card" style="padding: 1.5rem;">
          <h3 style="font-size: 1.1rem; color: var(--primary); font-weight: 700; margin-bottom: 1rem; border-bottom: 2px solid var(--primary-light); padding-bottom: 0.5rem;">
            📚 Weitere Artikel
          </h3>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            {recentArticles.map((ra) => (
              <a href={`/ratgeber/${ra.slug}/`} style="display: flex; gap: 0.75rem; text-decoration: none; align-items: center;">
                <img src={ra.image} alt={ra.title} style="width: 60px; height: 60px; object-cover; border-radius: 0.375rem;" />
                <div>
                  <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--text); line-height: 1.3;">
                    {ra.title}
                  </h4>
                  <span style="font-size: 0.7rem; color: var(--solar-color); font-weight: 600;">Mehr lesen →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>

  <style>
    .article-sidebar-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      align-items: start;
    }
    @media (min-width: 1024px) {
      .article-sidebar-grid {
        grid-template-columns: 2.2fr 1fr;
      }
    }
  </style>
</BaseLayout>
