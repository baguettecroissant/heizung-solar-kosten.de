---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllArticles } from '../../data/blog-articles';
import { siteConfig } from '../../../site.config';

const articles = getAllArticles();
---

<BaseLayout title={`Ratgeber & Kosten-Guides | ${siteConfig.name}`} canonical="/ratgeber">
  <!-- Header -->
  <div style="background: var(--primary); color: white; padding: 5rem 0 3rem 0; text-align: center; margin-bottom: 3rem;">
    <div class="container">
      <span class="hero-badge">📚 Energie-Wissen</span>
      <h1 style="color: white; font-size: 2.5rem; margin-top: 0.5rem;">Ratgeber & Kosten-Guides</h1>
      <p style="color: rgba(255,255,255,0.8); max-width: 600px; margin: 0.75rem auto 0 auto; font-size: 1.05rem;">
        Ausführliche Informationen zur Auslegung, Finanzierung, Förderung und Amortisation der Kombination aus Solaranlage und Wärmepumpe.
      </p>
    </div>
  </div>

  <div class="container" style="margin-bottom: 5rem;">
    <div class="grid grid-cols-3">
      {articles.map((article) => (
        <a href={`/ratgeber/${article.slug}/`} class="card" style="display: flex; flex-direction: column; overflow: hidden; padding: 0; border: 1px solid #E2E8F0; border-radius: 1rem; text-decoration: none;">
          <img src={article.image} alt={article.title} style="width: 100%; height: 180px; object-cover; border-bottom: 1px solid #E2E8F0;" />
          <div style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 1rem;">
            <div>
              <span class="font-data" style="font-size: 0.7rem; font-weight: 700; color: var(--solar-color); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">
                {article.category}
              </span>
              <h3 style="font-size: 1.15rem; color: var(--primary); font-weight: 700; line-height: 1.3;">
                {article.title}
              </h3>
              <p style="color: var(--text-light); font-size: 0.85rem; line-height: 1.5; margin-top: 0.5rem;">
                {article.summary}
              </p>
            </div>
            <span style="font-weight: 700; font-size: 0.8rem; color: var(--solar-color); display: inline-flex; align-items: center; gap: 0.25rem;">
              Artikel lesen →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
